# Caddy configuration for production (ADR 0005). Values come from .env via
# compose.prod.yaml. Caddy obtains and renews the TLS certificate itself and
# redirects HTTP to HTTPS. No ACME account email: Let's Encrypt no longer
# sends expiry notices, and Caddy renews automatically.

{$SITE_ADDRESS} {
	# Server-specific snippets, e.g. Basic Auth during a test phase
	# (see deploy/caddy.d/README.md). No matching file is fine.
	import /etc/caddy/caddy.d/*.caddy

	encode zstd gzip

	header {
		# Never indexed (brief 4.7). Fixed, not configurable; Django sends
		# the same header (core.middleware.NoIndexMiddleware).
		X-Robots-Tag "noindex, nofollow"
		# Browsers use HTTPS only for the next year (not for subdomains,
		# so mail and other services on subdomains are unaffected).
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}

	# Upload limit for a whole request (brief 5.7), e.g. several photos of
	# one submission. Django limits each file (UPLOAD_MAX_PHOTO_MB,
	# UPLOAD_MAX_FILE_MB) and warns if this limit is smaller than one file.
	request_body {
		max_size {$UPLOAD_MAX_REQUEST_MB:100}MB
	}

	# Everything, including /static/ (served by WhiteNoise). Uploaded files
	# are private and only served by Django after an access check
	# (ADR 0009); Caddy has no access to the media volume.
	handle {
		reverse_proxy web:8000
	}

	# Too large: a short German message instead of an empty page.
	handle_errors 413 {
		header Content-Type "text/plain; charset=utf-8"
		header X-Robots-Tag "noindex, nofollow"
		respond "Das ist zu viel auf einmal (höchstens {$UPLOAD_MAX_REQUEST_MB:100} MB pro Speichern). Geh zurück und lade weniger oder kleinere Dateien auf einmal hoch." 413
	}

	log {
		output stdout
		format console
	}
}

# Other host names (e.g. www.example.ch) redirect permanently to the main
# address, keeping the path. Caddy gets certificates for them too.
# Without REDIRECT_ADDRESSES, compose.prod.yaml sets a harmless placeholder.
{$REDIRECT_ADDRESSES} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}
