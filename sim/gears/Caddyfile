# Caddy inside the sim image (ADR 0019): serves the GearsBot files on plain
# HTTP port 8080, inside the Docker network only. The main Caddy terminates
# HTTPS for SIM_ADDRESS and proxies here.
#
# CHECKERMINT_ORIGIN: the Checkermint origin that serves task world files
# (connect-src). Default: production.

{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	# @current: path of the pinned GearsBot version, written by build.py.
	import /etc/caddy/version.caddy

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' {$CHECKERMINT_ORIGIN:https://checkermint.ch}; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	# Pinned version and mirrored files never change under the same path.
	handle @current {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle /mirror/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# An older version (old link or open tab after an update): start again.
	handle /v/* {
		redir * /?{query} 302
	}
	# Start page, start.js, robots.txt: always revalidated.
	handle {
		header Cache-Control "no-cache"
		file_server
	}

	log {
		output stdout
		format console
	}
}
